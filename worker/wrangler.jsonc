{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paragem-certa",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Só o domínio próprio (paragemcerta.pixellusitano.com); o endereço workers.dev fica desligado.
  "workers_dev": false,
  // Desligar o workers.dev não desliga os endereços de pré-visualização: também ficam desligados, para o servidor só existir no domínio próprio.
  "preview_urls": false,
  // Os ficheiros de public/ (termos, apagar conta, dados/config.json) saem sem passar pelo Worker;
  // só a API e a política de privacidade (que leva o nome do responsável) passam por ele.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/privacidade"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paragem-certa",
      // A base na UE, criada com `wrangler d1 create paragem-certa --jurisdiction=eu`. O id não é segredo.
      "database_id": "e14c6603-de3c-42e8-9a04-3b4bb12ece8d",
      "migrations_dir": "migrations"
    }
  ],
  // As fotos da comunidade, na UE: o pendente é privado (só o Worker e o pc-admin o leem); o outro serve as aprovadas
  // em fotos.pixellusitano.com. Os buckets são criados pelo autor com `wrangler r2 bucket create … --jurisdiction eu`.
  "r2_buckets": [
    { "binding": "FOTOS_PENDENTES", "bucket_name": "pc-fotos-pendentes", "jurisdiction": "eu" },
    { "binding": "FOTOS", "bucket_name": "pc-fotos", "jurisdiction": "eu" }
  ],
  // No máximo 10 escritas da comunidade por minuto e por conta (a chave é o id da conta).
  // LIMITE_AUTH: 5 pedidos de entrada (/api/auth/) em 10 segundos por IP, aproximado (a Cloudflare junta as contas em segundo
  // plano e deixa passar rajadas). Fica aqui porque a única regra grátis de limite de pedidos da zona é a do site.
  "ratelimits": [
    { "name": "LIMITADOR", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LIMITE_AUTH", "namespace_id": "1002", "simple": { "limit": 5, "period": 10 } }
  ],
  // Corre na Cloudflare, não no telemóvel: apaga o que passou os prazos.
  "triggers": { "crons": ["0 3 * * *"] },
  // Definidos pelo autor com `wrangler secret put`; nunca ficam no repositório.
  // GOOGLE_WEB_CLIENT_ID é o id do cliente Web da consola da Google (o `aud` dos tokens).
  // CF_PURGE_TOKEN e CF_ZONA limpam a cache das fotos apagadas; EMAIL_AUTOR recebe os avisos de denúncias de perigo.
  "secrets": { "required": ["RESEND_API_KEY", "RESPONSAVEL", "GOOGLE_WEB_CLIENT_ID", "CF_PURGE_TOKEN", "CF_ZONA", "EMAIL_AUTOR"] }
}
