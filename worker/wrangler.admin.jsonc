{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A página de revisão do autor: um Worker à parte, só no workers.dev e com o Cloudflare Access à frente do Worker
  // inteiro (a política só deixa o email do autor). O Worker volta a validar o cabeçalho Cf-Access-Jwt-Assertion.
  "name": "pc-admin",
  "main": "src/admin/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Sem endereços de pré-visualização: cada um seria outra porta que o Access teria de cobrir.
  "preview_urls": false,
  // O mesmo D1 do Worker público; sem migrations_dir: só a wrangler.jsonc migra.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paragem-certa",
      // A mesma base da wrangler.jsonc.
      "database_id": "e14c6603-de3c-42e8-9a04-3b4bb12ece8d"
    }
  ],
  // Definidos pelo autor com `wrangler secret put -c wrangler.admin.jsonc`; nunca ficam no repositório.
  // ACCESS_EQUIPA é o endereço da equipa do Zero Trust (https://<equipa>.cloudflareaccess.com) e ACCESS_AUD a etiqueta
  // de audiência da aplicação do Access. Sem eles, ou sem EMAIL_AUTOR, a página não mostra nada a ninguém.
  "secrets": { "required": ["RESEND_API_KEY", "ACCESS_EQUIPA", "ACCESS_AUD", "EMAIL_AUTOR", "CHAVE_MARCA_EMAIL"] }
}
