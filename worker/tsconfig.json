{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  // worker-configuration.d.ts é gerado por `npm run tipos` (wrangler types) e não vai para o git.
  // O vitest.config.ts corre no Node, não no Worker, e fica de fora.
  "include": ["src", "test", "worker-configuration.d.ts"]
}
