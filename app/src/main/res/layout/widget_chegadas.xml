<?xml version="1.0" encoding="utf-8"?>
<!-- É o que o Android mostra antes do primeiro desenho e na pré-visualização: sem chegadas a fingir. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:clipToOutline="true"
    android:orientation="vertical">

    <!-- A faixa vai de ponta a ponta: o enchimento é do corpo e do nome, não da raiz. -->
    <!-- Altura fixa: o fundo do Android 12 ou mais traz o padrão de 88 dp, e com wrap_content a faixa crescia até lá. -->
    <LinearLayout
        android:id="@+id/widget_faixa"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/widget_faixa"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/widget_paragem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_nome"
            android:fontFamily="sans-serif-black"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/widget_atualizar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_atualizar"
            android:src="@drawable/widget_atualizar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <!-- Com peso: em pouca altura cortam-se as chegadas, nunca o "atualizado às". -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_descricao"
                android:textColor="@color/widget_texto"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/widget_linha_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_linha_1_nome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_selo"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:minWidth="48dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_linha_1_destino"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_linha_1_hora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_linha_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_linha_2_nome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_selo"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:minWidth="48dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_linha_2_destino"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_linha_2_hora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_linha_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_linha_3_nome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_selo"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:minWidth="48dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_linha_3_destino"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_linha_3_hora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_rodape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_cinzento"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
