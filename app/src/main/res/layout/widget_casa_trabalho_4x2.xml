<?xml version="1.0" encoding="utf-8"?>
<!-- O 4×2, que é também a pré-visualização e o desenho antes do primeiro: só os nomes, sem ligações a fingir. -->
<!-- Os ids de cada destino escrevem-se por extenso: um include repetido repetia-os, e o RemoteViews só achava o primeiro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:clipToOutline="true"
    android:orientation="vertical">

    <!-- Altura fixa: o fundo do Android 12 ou mais traz o padrão de 88 dp, e com wrap_content a faixa crescia até lá. -->
    <LinearLayout
        android:id="@+id/ct_faixa"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/widget_faixa"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/ct_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="@string/widget_casa_trabalho_nome"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/ct_atualizar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_atualizar"
            android:src="@drawable/widget_atualizar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/ct_casa"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ct_casa_icone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_casa" />

                <TextView
                    android:id="@+id/ct_casa_nome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:text="@string/locais_casa"
                    android:textColor="@color/widget_texto"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- O selo leva o número da linha; sem número, o selo do ícone (o modo, ou "a pé" sem fundo). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ct_casa_selo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/widget_selo"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="36dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ct_casa_selo_icone"
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/widget_selo"
                    android:importantForAccessibility="no"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ct_casa_texto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textColor="@color/widget_cinzento"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- FrameLayout e não View: o RemoteViews não aceita uma View simples. -->
        <FrameLayout
            android:id="@+id/ct_divisoria"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_contorno" />

        <LinearLayout
            android:id="@+id/ct_trabalho"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ct_trabalho_icone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_trabalho" />

                <TextView
                    android:id="@+id/ct_trabalho_nome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:text="@string/locais_trabalho"
                    android:textColor="@color/widget_texto"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- O selo leva o número da linha; sem número, o selo do ícone (o modo, ou "a pé" sem fundo). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ct_trabalho_selo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/widget_selo"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="36dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ct_trabalho_selo_icone"
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/widget_selo"
                    android:importantForAccessibility="no"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ct_trabalho_texto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textColor="@color/widget_cinzento"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/ct_rodape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_cinzento"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
