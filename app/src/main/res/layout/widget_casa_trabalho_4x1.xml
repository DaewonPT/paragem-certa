<?xml version="1.0" encoding="utf-8"?>
<!-- O 4×1: não cabem a faixa nem o rodapé. Um destino de cada vez, cada um com o seu Trocar, e o ↻ à direita. -->
<!-- Os ids de cada destino escrevem-se por extenso, como no 4×2. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:clipToOutline="true"
    android:orientation="vertical">

    <!-- FrameLayout e não View: o RemoteViews não aceita uma View simples. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@drawable/widget_friso" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="4dp">

        <!-- O desenho fixa o intervalo (8 s, ou parado) e o destino à vista. -->
        <ViewFlipper
            android:id="@+id/ct_flipper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autoStart="true"
            android:flipInterval="8000"
            android:inAnimation="@android:anim/fade_in"
            android:outAnimation="@android:anim/fade_out">

        <LinearLayout
            android:id="@+id/ct_casa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ct_casa_icone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_casa" />

                    <TextView
                        android:id="@+id/ct_casa_nome"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="@string/locais_casa"
                        android:textColor="@color/widget_texto"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- O selo leva o número da linha; sem número, o selo do ícone (o modo, ou "a pé" sem fundo). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ct_casa_selo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/widget_selo"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minWidth="36dp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ct_casa_selo_icone"
                        android:layout_width="36dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/widget_selo"
                        android:importantForAccessibility="no"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/ct_casa_texto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textColor="@color/widget_cinzento"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/ct_casa_trocar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_trocar"
                android:src="@drawable/widget_trocar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ct_trabalho"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ct_trabalho_icone"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_trabalho" />

                    <TextView
                        android:id="@+id/ct_trabalho_nome"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="@string/locais_trabalho"
                        android:textColor="@color/widget_texto"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- O selo leva o número da linha; sem número, o selo do ícone (o modo, ou "a pé" sem fundo). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ct_trabalho_selo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/widget_selo"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:minWidth="36dp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ct_trabalho_selo_icone"
                        android:layout_width="36dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/widget_selo"
                        android:importantForAccessibility="no"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/ct_trabalho_texto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textColor="@color/widget_cinzento"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/ct_trabalho_trocar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_trocar"
                android:src="@drawable/widget_trocar" />
        </LinearLayout>
        </ViewFlipper>

        <ImageButton
            android:id="@+id/ct_atualizar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_atualizar"
            android:src="@drawable/widget_atualizar" />
    </LinearLayout>
</LinearLayout>
