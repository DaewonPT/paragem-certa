<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 ou mais recente. O ficheiro dos widgets tem a última posição: nem vai para a cópia nem passa para um telemóvel novo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="widgets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="widgets.xml" />
    </device-transfer>
</data-extraction-rules>
