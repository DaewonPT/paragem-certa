<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis 0: nada acorda o widget por horas; só redesenha quando o Android arranca e vai à rede só no ↻ ou com a app aberta. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="pt.pixellusitano.paragemcerta.widget.EscolherParagemAtividade"
    android:description="@string/widget_descricao"
    android:initialLayout="@layout/widget_chegadas"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/widget_chegadas"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
